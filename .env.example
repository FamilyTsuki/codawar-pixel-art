# Configuration Codawar Pixel Studio (copier vers .env, ne jamais commiter .env)

# --- Sécurité (obligatoire) ---
# Secret serveur pour le hachage des mots de passe : openssl rand -hex 32
# NE JAMAIS LE CHANGER après la création de comptes, sinon tous les mots de passe deviennent invalides.
AUTH_PEPPER=CHANGE_MOI_openssl_rand_hex_32
# 1 derrière HTTPS (Route Cosmos), 0 en local http
COOKIE_SECURE=0
SESSION_TTL_DAYS=30

# --- Base PostgreSQL (Docker Compose) ---
POSTGRES_USER=codawar
POSTGRES_PASSWORD=CHANGE_MOI_mot_de_passe_fort
POSTGRES_DB=codawar

# --- Mise à jour auto ---
AUTO_PULL=1
AUTO_PULL_INTERVAL=300
AUTO_PULL_BRANCH=main

# --- Exécution directe sans Docker (optionnel) ---
# CODAWAR_PG=dbname=codawar
# PORT=5055
# HOST=127.0.0.1
# Le cookie Codawar n'est plus ici : il se règle par compte dans l'interface.
