# Configuration environnement Codawar Pixel Studio (modèle à copier vers .env)

# TON cookie de session Codawar (à récupérer sur codawar.coda.school)
CODAWAR_COOKIE=codawar_session=VOTRE_COOKIE_ICI

# Base PostgreSQL locale (pour exécution directe sans Docker)
CODAWAR_PG=dbname=codawar

# Base PostgreSQL Docker Compose
POSTGRES_USER=codawar
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=codawar

# Configuration serveur
PORT=5055
HOST=127.0.0.1
